@using CRGorman.Demo.ViewModels
@using CRGorman.Demo.Web.Data
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject TableOfContents ToC
@inject GuideApiClient GuideApi

@code {
    private string GenerateHref(string vanityURL, int actNumber = 0, string? FileName = "")
    {
        var url = $"guide/";
        if (!string.IsNullOrWhiteSpace(vanityURL))
        {
            url += $"{vanityURL}/";
            if (actNumber != 0)
            {
                url += $"{actNumber.ToString()}/";
                url += !string.IsNullOrWhiteSpace(FileName) ? $"{FileName}/" : string.Empty;
            }
        }
        return url;
    }
}

<div class="top-row ps-6 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Freespace Speedrunning</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <ul class="no-bullets">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="setup">
                    <span class="bi bi-play" aria-hidden="true"></span> Setup - Getting Started
                </NavLink>
            </li>
            @foreach (var game in ToC.MissionList)
            {
                <li class="nav-item px-3">
                    <a class="sidenav-link">
                        <span class="bi bi-plus-square-fill" aria-hidden="true"></span>
                    </a>
                    <NavLink class="nav-link" href="@GenerateHref(game.VanityURL)" Match="NavLinkMatch.All">
                        <!--TODO: Try  data-enhance-nav="true"-->
                        @game.Name
                    </NavLink>
                    @if (game.Acts.Count > 1)
                    {
                        <ul>
                            @foreach (var act in game.Acts)
                            {
                                <li>
                                    <NavLink class="nav-link" href="@GenerateHref(game.VanityURL, act.ActNumber)" Match="NavLinkMatch.All">Act @act.ActNumber: @act.Name</NavLink>
                                    <ul>
                                        @foreach (var mission in act.Missions)
                                        {
                                            <li>
                                                <NavLink class="nav-link" href="@GenerateHref(game.VanityURL, act.ActNumber, mission.FileName)" Match="NavLinkMatch.All">@mission.FileName: @mission.Name</NavLink>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <NavLink class="nav-link" href="@GenerateHref(game.VanityURL, game.Acts.First().ActNumber)" Match="NavLinkMatch.All">Act @game.Acts.First().ActNumber: @game.Acts.First().Name</NavLink>
                        <ul>
                            @foreach (var mission in game.Acts.First().Missions)
                            {
                                <li>
                                    <NavLink class="nav-link" href="@GenerateHref(game.VanityURL, game.Acts.First().ActNumber, mission.FileName)" Match="NavLinkMatch.All">@mission.FileName: @mission.Name</NavLink>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </nav>
</div>
