@page "/guide/{gameParam:regex(^[\\da-zA-Z]{{0,12}}$)}/{actParam:int?}/{missionParam:nonfile?}"
@using CRGorman.Demo.ViewModels
@using CRGorman.Demo.Web.Data
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject TableOfContents ToC
@inject GuideApiClient GuideApi

<PageTitle>Freespace Speedrun Guide</PageTitle>

<p>This component demonstrates showing data loaded from a backend API service.</p>

@if (game == null || game.Id == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@game.Name</h1>
    foreach (var act in game.Acts.Where(x => x.Id == actId || actId == null))
    {
        <h2>Act @act.ActNumber: @act.Name</h2>
        foreach (var mission in act.Missions.Where(x => x.Id == missionId || missionId == null))
        {
            <h3>@mission.FileName: @mission.Name</h3>
            <div class="">
                <div>@mission.Description</div>
                <div>@mission.Loadout</div>
                <div>@mission.Guide</div>
                <div>@mission.Script</div>
            </div>
        }
    }
}

@code {
    [Parameter]
    public string? gameParam { get; set; }

    public int? gameId { get; set; }

    [Parameter]
    public int? actParam { get; set; }

    public int? actId { get; set; }

    [Parameter]
    public string? missionParam { get; set; }

    public int? missionId { get; set; }

    private GameDto game = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(gameParam))
        {
            //Is it a number?
            if (int.TryParse(gameParam, out int pGameId))
            {
                gameId = pGameId;
            }
            else
            {
                gameId = ToC.MissionList.FirstOrDefault(x => x.VanityURL == gameParam)?.Id;
            }
        }

        if (actParam.HasValue)
        {
            actId = ToC.MissionList.FirstOrDefault(x => x.Id == gameId)?.Acts.FirstOrDefault(x => x.ActNumber == actParam)?.Id;
        }

        if (!string.IsNullOrWhiteSpace(missionParam))
        {
            missionId = ToC.MissionList.FirstOrDefault(x => x.Id == gameId)?.Acts.FirstOrDefault(x => x.Id == actId)?.Missions.FirstOrDefault(x => x.FileName == missionParam)?.Id;
        }

        if (gameId.HasValue)
        {
            game = await GuideApi.GetGameAsync(gameId);
        }
        else
        {
            game = null;
        }
    }
}
