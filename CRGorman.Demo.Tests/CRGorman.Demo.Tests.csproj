<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="9.3.0" />
    <PackageReference Include="MSTest" Version="3.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CRGorman.Demo.ApiService\CRGorman.Demo.ApiService.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.AppHost\CRGorman.Demo.AppHost.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.MigrationService\CRGorman.Demo.MigrationService.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.ServiceDefaults\CRGorman.Demo.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.SpeedrunData\CRGorman.Demo.SpeedrunData.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.ViewModels\CRGorman.Demo.ViewModels.csproj" />
    <ProjectReference Include="..\CRGorman.Demo.Web\CRGorman.Demo.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Aspire.Hosting.ApplicationModel" />
    <Using Include="Aspire.Hosting.Testing" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
